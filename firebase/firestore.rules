rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 使用者個人資料（users/{uid} 本體）
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // 卡片收藏：users/{uid}/cardFavorites/{cardId}
    match /users/{userId}/cardFavorites/{cardId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // 使用者其他子集合（countingSessions 等）
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // 公開唯讀（若之後要放賽事榜等）
    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
