rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isWholeNumber(n) {
      return n is int || (n is float && n == int(n));
    }

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function auctionDoc(auctionId) {
      return get(/databases/$(database)/documents/auctions/$(auctionId)).data;
    }

    // 使用者個人資料（users/{uid} 本體）
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // 卡片收藏：users/{uid}/cardFavorites/{cardId}
    match /users/{userId}/cardFavorites/{cardId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // 使用者其他子集合（countingSessions、auctionActivity 等）
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // 公開唯讀（若之後要放賽事榜等）
    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // --- 拍賣（公開競標過程；金流／物流不在站內） ---
    match /auctions/{auctionId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && isNonEmptyString(request.resource.data.sellerName, 40)
        && isNonEmptyString(request.resource.data.title, 200)
        && isNonEmptyString(request.resource.data.description, 4000)
        && isNonEmptyString(request.resource.data.itemStatus, 80)
        && request.resource.data.shipping is string
        && request.resource.data.shipping.size() <= 200
        && request.resource.data.images is list
        && request.resource.data.images.size() > 0
        && request.resource.data.images.size() <= 12
        && isWholeNumber(request.resource.data.startPrice)
        && request.resource.data.startPrice > 0
        && request.resource.data.highestAmount == request.resource.data.startPrice
        && isWholeNumber(request.resource.data.quantity)
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 99
        && request.resource.data.currency == "JPY"
        && request.resource.data.bidCount == 0
        && request.resource.data.highestBidder == ""
        && request.resource.data.highestBidderUid == ""
        && request.resource.data.status == "open"
        && request.resource.data.earlyEnd is bool
        && request.resource.data.autoExtend is bool
        && isWholeNumber(request.resource.data.autoExtendMinutes)
        && request.resource.data.autoExtendMinutes >= 1
        && request.resource.data.autoExtendMinutes <= 60
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.time
        && request.resource.data.endTime > request.resource.data.startTime
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.auctionId == auctionId;

      allow delete: if false;

      // 賣家可將進行中拍賣標為 closed（提前結束／手動結標）
      allow update: if signedIn()
        && resource.data.sellerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == "closed"
        && resource.data.status == "open";

      // 下標者更新最高價快取（與 bids create 同 Transaction）
      allow update: if signedIn()
        && resource.data.keys().hasAll([
             'startPrice', 'highestAmount', 'bidCount', 'endTime', 'title'
           ])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'highestAmount',
               'highestBidder',
               'highestBidderUid',
               'bidCount',
               'endTime',
               'updatedAt'
             ])
        && isWholeNumber(request.resource.data.highestAmount)
        && request.resource.data.highestAmount > resource.data.highestAmount
        && isWholeNumber(request.resource.data.bidCount)
        && request.resource.data.bidCount == resource.data.bidCount + 1
        && request.resource.data.highestBidderUid == request.auth.uid
        && isNonEmptyString(request.resource.data.highestBidder, 40)
        && request.time < resource.data.endTime
        && resource.data.status == "open"
        && request.resource.data.endTime >= resource.data.endTime
        && request.resource.data.startPrice == resource.data.startPrice
        && request.resource.data.title == resource.data.title
        && (
             !('sellerUid' in resource.data)
             || resource.data.sellerUid != request.auth.uid
           );

      match /bids/{bidId} {
        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.keys().hasAll([
               'bidderUid', 'bidderName', 'amount', 'quantity', 'createdAt'
             ])
          && request.resource.data.bidderUid == request.auth.uid
          && isNonEmptyString(request.resource.data.bidderName, 40)
          && isWholeNumber(request.resource.data.amount)
          && request.resource.data.amount > 0
          && request.resource.data.amount > auctionDoc(auctionId).highestAmount
          && isWholeNumber(request.resource.data.quantity)
          && request.resource.data.quantity > 0
          && request.resource.data.createdAt == request.time
          && request.time < auctionDoc(auctionId).endTime
          && auctionDoc(auctionId).status == "open"
          && (
               !('sellerUid' in auctionDoc(auctionId))
               || auctionDoc(auctionId).sellerUid != request.auth.uid
             );

        allow update, delete: if false;
      }
    }
  }
}
