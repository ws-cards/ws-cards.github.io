rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isWholeNumber(n) {
      return n is int || (n is float && n == int(n));
    }

    // 使用者個人資料（users/{uid} 本體）
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // 卡片收藏：users/{uid}/cardFavorites/{cardId}
    match /users/{userId}/cardFavorites/{cardId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // 使用者其他子集合（countingSessions 等）
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // 公開唯讀（若之後要放賽事榜等）
    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // --- 拍賣（公開競標過程；金流／物流不在站內） ---
    // 主檔由 Console／後台建立；前端僅能在下標時更新最高價快取欄位。
    match /auctions/{auctionId} {
      allow read: if true;

      allow create, delete: if false;

      allow update: if signedIn()
        && resource.data.keys().hasAll([
             'startPrice', 'highestAmount', 'bidCount', 'endTime', 'title'
           ])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'highestAmount',
               'highestBidder',
               'highestBidderUid',
               'bidCount',
               'endTime',
               'updatedAt'
             ])
        && isWholeNumber(request.resource.data.highestAmount)
        && request.resource.data.highestAmount > resource.data.highestAmount
        && isWholeNumber(request.resource.data.bidCount)
        && request.resource.data.bidCount == resource.data.bidCount + 1
        && request.resource.data.highestBidderUid == request.auth.uid
        && request.resource.data.highestBidder is string
        && request.resource.data.highestBidder.size() > 0
        && request.resource.data.highestBidder.size() <= 40
        && request.time < resource.data.endTime
        && request.resource.data.endTime >= resource.data.endTime
        && request.resource.data.startPrice == resource.data.startPrice
        && request.resource.data.title == resource.data.title;

      match /bids/{bidId} {
        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.keys().hasAll([
               'bidderUid', 'bidderName', 'amount', 'quantity', 'createdAt'
             ])
          && request.resource.data.bidderUid == request.auth.uid
          && request.resource.data.bidderName is string
          && request.resource.data.bidderName.size() > 0
          && request.resource.data.bidderName.size() <= 40
          && isWholeNumber(request.resource.data.amount)
          && request.resource.data.amount > 0
          && request.resource.data.amount
               > get(/databases/$(database)/documents/auctions/$(auctionId))
                   .data.highestAmount
          && isWholeNumber(request.resource.data.quantity)
          && request.resource.data.quantity > 0
          && request.resource.data.createdAt == request.time
          && request.time
               < get(/databases/$(database)/documents/auctions/$(auctionId))
                   .data.endTime;

        allow update, delete: if false;
      }
    }
  }
}
